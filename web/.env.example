# Frontend Supabase settings (public/publishable key; existing chat data/realtime).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only Vercel variables. Never prefix these with VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SECRET_OR_SERVICE_ROLE_KEY
JWT_SECRET=generate-a-random-secret-at-least-32-characters-long
